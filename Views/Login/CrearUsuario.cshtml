@model CrearUsuarioViewModel
  <section class="container d-flex justify-content-center align-items-center" style="min-height: 100vh;">
        <section class="card shadow-sm p-4" style="max-width: 400px; width: 100%;">
            <h4 class="card-title text-center mb-4">Cerrar usuario</h4>
            <form method="post" asp-controller="Login" asp-action="CrearUsuario">
                <section class="form-group d-flex justify-content-between p-2">
                    <label asp-for="Nombre" class="form-label">Nombre:</label>
                    <input type="text" class="form-control-sm" asp-for="Nombre" required />
                </section>
                <span asp-validation-for="Nombre" class="text-danger"></span>
                <section class="form-group d-flex justify-content-between p-2">
                    <label asp-for="Usuario" class="form-label">Usuario:</label>
                    <input asp-for="Usuario" type="text" class="form-control-sm" required />
                </section>
                <span asp-validation-for="Usuario" class="text-danger"></span>
                <section class="form-group d-flex justify-content-between p-2">
                    <label asp-for="Pass" class="form-label">Contraseña:</label>
                    <input asp-for="Pass" type="password" class="form-control-sm" required />
                </section>
                <span asp-validation-for="Pass" class="text-danger"></span>
                <section class="form-group d-flex justify-content-between p-2">
                    <label asp-for="Rol" class="form-label">Rol:</label>
                    <select asp-for="Rol" asp-items="Model.RolesDisponibles" class="form-control-sm">
                        <option value="">seleccione un rol</option>

                    </select>
                </section>
                <span asp-validation-for="Rol" class="text-danger"></span>
                <section class="form-group d-flex justify-content-between p-2">
                    <input type="submit" class="btn btn-primary" value="Iniciar sesion">
                    <a class="btn btn-danger " asp-controller="Login" asp-action="Index">volver</a>
                </section>
            </form> 
        </section>
    </section>
    @section Scripts{<partial name="_ValidationScriptsPartial"/>}
